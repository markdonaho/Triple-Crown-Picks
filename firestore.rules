rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user signed in?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Is the user an Admin?
    // Reads the user's document to check the isAdmin flag.
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- User Profiles ---
    match /users/{userId} {
      // Any signed-in user can read any profile.
      allow read: if isSignedIn();
      // Users can write their own profile only.
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Races Collection (Root Level) ---
    match /races/{raceId} {
      // Any signed-in user can read race info.
      allow read: if isSignedIn();
      // Only admins can write (create/update/delete) races.
      allow write: if isAdmin();
    }

    // --- Horses Collection (Root Level) ---
    match /horses/{horseId} {
      // Any signed-in user can read horse info.
      allow read: if isSignedIn();
      // Only admins can write (create/update/delete) horses.
      allow write: if isAdmin();
    }

    // --- Picks Collection (Root Level) ---
    match /picks/{pickId} {
      // Any signed-in user can read any pick.
      // App logic should handle displaying only relevant picks.
      allow read: if isSignedIn();

      // Users can create/update their own picks.
      // Relies on client code to check race status ('open'/'upcoming').
      // Ensures userId is set correctly on create and cannot be changed on update.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                      && request.resource.data.userId == resource.data.userId; // Prevent changing owner

      // Admins can delete picks (e.g., problematic entries), users cannot.
      allow delete: if isAdmin();
    }
  }
}